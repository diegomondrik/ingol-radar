{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "date",
    "status",
    "owner",
    "lane",
    "work_item",
    "supersedes",
    "superseded_by"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "superseded", "rejected"]
    },
    "owner": { "type": "string", "minLength": 1 },
    "lane": { "type": "string", "enum": ["fast", "standard", "controlled"] },
    "work_item": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
    },
    "superseded_by": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
    },
    "external_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["envelope_id", "content_sha256", "promotion_id", "assertion", "adapter"],
        "properties": {
          "envelope_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "promotion_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "assertion": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    }
  }
}
