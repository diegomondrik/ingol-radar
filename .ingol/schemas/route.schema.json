{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/route.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "work_item",
    "task_class",
    "eligibility_reason",
    "selection_reason",
    "floor_source",
    "capability_evidence_ref",
    "availability_probe",
    "selected_route",
    "policy_revision",
    "registry_revision",
    "decided_utc",
    "outcome",
    "escalation_history"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "work_item": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "task_class": { "type": "string", "minLength": 1 },
    "eligibility_reason": { "type": "string", "minLength": 1 },
    "selection_reason": { "type": "string", "minLength": 1 },
    "floor_source": { "type": "string", "minLength": 1 },
    "capability_evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "dated_utc"],
      "properties": {
        "reference": { "type": "string", "minLength": 1 },
        "dated_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "availability_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "probed_utc"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "probed_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      }
    },
    "selected_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 },
        "cost_class": { "type": "string", "minLength": 1 },
        "latency_class": { "type": "string", "minLength": 1 }
      }
    },
    "policy_revision": { "type": "string", "minLength": 1 },
    "registry_revision": { "type": "string", "minLength": 1 },
    "decided_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "escalated", "failed"]
    },
    "escalation_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "at"],
        "properties": {
          "reason": { "type": "string", "minLength": 1 },
          "at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "escalated_to": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
