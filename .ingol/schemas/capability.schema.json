{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/capability.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "purpose",
    "task_shapes",
    "role",
    "role_requires_independence",
    "model_eligibility_requirement",
    "tool_requirements",
    "permissions",
    "readable_data",
    "writable_surfaces",
    "risk_floor",
    "evidence_ref",
    "version",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "purpose": { "type": "string", "minLength": 1 },
    "task_shapes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "role": {
      "type": "string",
      "enum": [
        "planner",
        "supervisor-router",
        "scoped-worker",
        "independent-reviewer",
        "governance-core"
      ]
    },
    "role_requires_independence": {
      "type": "string",
      "enum": ["required", "not_required"]
    },
    "model_eligibility_requirement": {
      "type": "string",
      "enum": ["baseline", "standard", "controlled"]
    },
    "tool_requirements": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "readable_data": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "writable_surfaces": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risk_floor": {
      "type": "string",
      "enum": ["fast", "standard", "controlled"]
    },
    "evidence_ref": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "delegation_ceiling": {
      "description": "The protected bound on what may ever be delegated to this capability (WI018-AC03, MA-02). It lives on the capability declaration, which is protected state, precisely so that a supervisor can decide how much of a ceiling to grant in one delegation record and can never decide the ceiling itself. Optional, because the two capabilities that predate this field -- a deterministic checker and a reviewer -- are not delegated to and declaring a ceiling for them would state a bound that governs nothing; a capability whose role is scoped-worker and which carries no ceiling must be grantable nothing at all -- a rule that belongs in Go rather than in a required field declarations have no use for, and that the delivery introducing this field does not yet build. budget_unit repeats the closed vocabulary of delegation.schema.json so that a grant and its ceiling cannot be denominated in different things: worker-invocations is what a deterministic control plane can count without trusting the thing it meters, and it bounds neither tokens, nor wall-clock time, nor money, nor anything spent inside one invocation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_unit", "max_budget_per_delegation", "max_concurrent_delegations"],
      "properties": {
        "budget_unit": { "type": "string", "enum": ["worker-invocations"] },
        "max_budget_per_delegation": { "type": "integer", "minimum": 1 },
        "max_concurrent_delegations": { "type": "integer", "minimum": 1 }
      }
    },
    "governed_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^\\s]+\\.md$" },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
