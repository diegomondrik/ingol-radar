{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_item",
    "status",
    "next_gate",
    "owner",
    "executor",
    "branch",
    "steps",
    "evaluations"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "work_item": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "active", "blocked", "ready", "integrated", "abandoned"]
    },
    "next_gate": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "executor": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "method", "control"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1, "pattern": "^[A-Z0-9-]+$" },
          "method": {
            "type": "string",
            "enum": [
              "deterministic",
              "adversarial",
              "platform-evidence",
              "external-evidence",
              "source-review",
              "independent-review"
            ]
          },
          "control": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
