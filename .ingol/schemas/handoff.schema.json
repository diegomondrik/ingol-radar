{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/handoff.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "generated_by",
    "source_state",
    "work_item",
    "contract_revision",
    "lane",
    "owner",
    "executor",
    "branch_or_worktree",
    "completed_evidence",
    "open_limitations",
    "stale_or_missing_authority",
    "exact_next_step"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected", "instant_utc"],
      "properties": {
        "protected": { "type": "boolean" },
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "run_attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "base_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "candidate_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "runner": { "type": "string", "minLength": 1 },
        "runner_os": { "type": "string", "minLength": 1 },
        "runner_arch": { "type": "string", "minLength": 1 },
        "instant_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "if": {
        "required": ["protected"],
        "properties": { "protected": { "const": true } }
      },
      "then": {
        "required": ["run_id", "run_attempt", "base_revision", "candidate_revision", "runner", "runner_os", "runner_arch"]
      }
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "revision"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition"],
          "properties": {
            "disposition": { "type": "string", "enum": ["derived", "absent"] },
            "value": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          },
          "if": {
            "required": ["disposition"],
            "properties": { "disposition": { "enum": ["derived"] } }
          },
          "then": { "required": ["value"] }
        }
      }
    },
    "work_item": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "contract_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "lane": { "type": "string", "enum": ["fast", "standard", "controlled"] },
    "owner": { "type": "string", "minLength": 1 },
    "executor": { "type": "string", "minLength": 1 },
    "branch_or_worktree": { "type": "string", "minLength": 1 },
    "completed_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "digest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "criterion": { "type": "string", "minLength": 1, "pattern": "^[A-Z0-9-]+$" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "open_limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "stale_or_missing_authority": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exact_next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_gate", "queue_state", "blocking"],
      "properties": {
        "next_gate": { "type": "string", "minLength": 1 },
        "queue_state": {
          "type": "string",
          "enum": ["queued", "blocked", "claimed", "integrating", "integrated"]
        },
        "blocking": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" }
        }
      }
    }
  }
}
