{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "work_item",
    "criterion",
    "disposition",
    "timestamp_utc",
    "detail",
    "limitations"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "work_item": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "criterion": { "type": "string", "minLength": 1, "pattern": "^[A-Z0-9-]+$" },
    "disposition": {
      "type": "string",
      "enum": ["passed", "failed", "not_applicable", "unverified"]
    },
    "timestamp_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "detail": { "type": "string", "minLength": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "protected_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "run_attempt",
        "base_revision",
        "candidate_revision",
        "checker_id",
        "checker_version",
        "checker_digest",
        "product_version",
        "runner",
        "runner_os",
        "runner_arch",
        "artifacts"
      ],
      "properties": {
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "run_attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "base_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "candidate_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "checker_id": { "type": "string", "minLength": 1 },
        "checker_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "checker_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "product_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "runner": { "type": "string", "minLength": 1 },
        "runner_os": { "type": "string", "minLength": 1 },
        "runner_arch": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputs", "outputs"],
          "properties": {
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "digest"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            },
            "outputs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "digest"],
                "properties": {
                  "path": { "type": "string", "minLength": 1 },
                  "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                }
              }
            }
          }
        },
        "context_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "installation_repository",
            "installation_revision",
            "baseline_repository",
            "baseline_revision",
            "candidate_repository",
            "candidate_revision",
            "effective_policy_digest"
          ],
          "properties": {
            "installation_repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/+-]{0,199}$" },
            "installation_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "baseline_repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/+-]{0,199}$" },
            "baseline_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "candidate_repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@:/+-]{0,199}$" },
            "candidate_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "effective_policy_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "authority", "rationale"],
      "properties": {
        "author": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "if": {
    "required": ["disposition"],
    "properties": { "disposition": { "enum": ["passed", "failed"] } }
  },
  "then": { "required": ["protected_run"] },
  "else": { "required": ["human"] }
}
