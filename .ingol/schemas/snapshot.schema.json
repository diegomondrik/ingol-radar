{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "generated_by",
    "source_state",
    "work_item",
    "lifecycle",
    "last_completed_action",
    "effective_authority",
    "actor",
    "evidence_references",
    "prohibitions",
    "next_action",
    "measurements"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protected", "instant_utc"],
      "properties": {
        "protected": { "type": "boolean" },
        "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "run_attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "base_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "candidate_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "runner": { "type": "string", "minLength": 1 },
        "runner_os": { "type": "string", "minLength": 1 },
        "runner_arch": { "type": "string", "minLength": 1 },
        "instant_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "if": {
        "required": ["protected"],
        "properties": { "protected": { "const": true } }
      },
      "then": {
        "required": ["run_id", "run_attempt", "base_revision", "candidate_revision", "runner", "runner_os", "runner_arch"]
      }
    },
    "source_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fingerprint", "revision"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition"],
          "properties": {
            "disposition": { "type": "string", "enum": ["derived", "absent"] },
            "value": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
          },
          "if": {
            "required": ["disposition"],
            "properties": { "disposition": { "enum": ["derived"] } }
          },
          "then": { "required": ["value"] }
        }
      }
    },
    "work_item": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition"],
      "properties": {
        "disposition": { "type": "string", "enum": ["derived", "absent"] },
        "state": {
          "type": "string",
          "enum": ["draft", "approved", "active", "blocked", "ready", "integrated", "abandoned"]
        }
      },
      "if": {
        "required": ["disposition"],
        "properties": { "disposition": { "enum": ["derived"] } }
      },
      "then": { "required": ["state"] }
    },
    "last_completed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition"],
      "properties": {
        "disposition": { "type": "string", "enum": ["derived", "absent"] },
        "event_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
        "from_state": {
          "type": "string",
          "enum": ["draft", "approved", "active", "blocked", "ready", "integrated", "abandoned"]
        },
        "to_state": {
          "type": "string",
          "enum": ["draft", "approved", "active", "blocked", "ready", "integrated", "abandoned"]
        },
        "instant_utc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        }
      },
      "if": {
        "required": ["disposition"],
        "properties": { "disposition": { "enum": ["derived"] } }
      },
      "then": { "required": ["event_id", "from_state", "to_state", "instant_utc"] }
    },
    "effective_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "decision_refs"],
      "properties": {
        "lane": { "type": "string", "enum": ["fast", "standard", "controlled"] },
        "decision_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "digest"],
            "properties": {
              "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "declared_by", "authenticated"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "declared_by": { "type": "string", "const": "plan.executor" },
        "authenticated": { "type": "boolean", "const": false }
      }
    },
    "evidence_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "digest"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "criterion": { "type": "string", "minLength": 1, "pattern": "^[A-Z0-9-]+$" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "prohibitions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next_gate", "first_unmet_criterion"],
      "properties": {
        "next_gate": { "type": "string", "minLength": 1 },
        "first_unmet_criterion": {
          "type": ["string", "null"],
          "pattern": "^[A-Z0-9-]+$"
        }
      }
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "criterion", "instant_utc", "freshness", "protected_run"],
        "properties": {
          "evidence_id": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
          "criterion": { "type": "string", "minLength": 1, "pattern": "^[A-Z0-9-]+$" },
          "instant_utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
          },
          "freshness": { "type": "string", "enum": ["fresh", "stale"] },
          "protected_run": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "run_attempt", "base_revision", "candidate_revision"],
            "properties": {
              "run_id": { "type": "string", "pattern": "^[1-9][0-9]*$" },
              "run_attempt": { "type": "string", "pattern": "^[1-9][0-9]*$" },
              "base_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "candidate_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
            }
          }
        }
      }
    }
  }
}
