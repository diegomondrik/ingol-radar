{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ingol.invalid/schemas/adapter.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter",
    "adapter_version",
    "compatible_core_schema_range",
    "instruction_surfaces",
    "hook_gate_capabilities",
    "mutation_class_coverage",
    "permissions",
    "sandbox_model",
    "branch_worktree_support",
    "subagent_behavior",
    "context_compaction_behavior",
    "review_support",
    "telemetry",
    "registry_revision",
    "model_registry",
    "routing",
    "external_content_boundary",
    "unsupported_features"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "adapter": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "adapter_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "compatible_core_schema_range": { "type": "string", "pattern": "^[12](-[12])?$" },
    "instruction_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hook_gate_capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "$ref": "#/$defs/capabilityStatus" }
        }
      }
    },
    "mutation_class_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_file_write",
        "structured_edit",
        "shell_or_process_execution",
        "patch_application",
        "subagent_or_delegated_executor",
        "external_tool_server_or_mcp",
        "build_step_generator_or_watcher",
        "git_index_or_ref_operation"
      ],
      "properties": {
        "direct_file_write": { "$ref": "#/$defs/mutationClassEntry" },
        "structured_edit": { "$ref": "#/$defs/mutationClassEntry" },
        "shell_or_process_execution": { "$ref": "#/$defs/mutationClassEntry" },
        "patch_application": { "$ref": "#/$defs/mutationClassEntry" },
        "subagent_or_delegated_executor": { "$ref": "#/$defs/mutationClassEntry" },
        "external_tool_server_or_mcp": { "$ref": "#/$defs/mutationClassEntry" },
        "build_step_generator_or_watcher": { "$ref": "#/$defs/mutationClassEntry" },
        "git_index_or_ref_operation": { "$ref": "#/$defs/mutationClassEntry" }
      }
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sandbox_model": {
      "type": "string",
      "enum": ["none", "process-isolated", "container", "vm", "unverified"],
      "description": "The isolation technology this adapter runs under. unverified is WI011-AC05's counterpart for this field: it names that the technology has not been established, rather than letting a declaration assert a specific one on no evidence."
    },
    "branch_worktree_support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch_support", "worktree_support"],
      "properties": {
        "branch_support": { "$ref": "#/$defs/capabilityStatus" },
        "worktree_support": { "$ref": "#/$defs/capabilityStatus" }
      }
    },
    "subagent_behavior": { "$ref": "#/$defs/freeformCapability" },
    "context_compaction_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_management", "compaction_behavior"],
      "properties": {
        "context_management": { "type": "string", "minLength": 1 },
        "compaction_behavior": { "type": "string", "minLength": 1 }
      }
    },
    "review_support": { "$ref": "#/$defs/freeformCapability" },
    "telemetry": { "$ref": "#/$defs/freeformCapability" },
    "registry_revision": { "type": "string", "minLength": 1 },
    "model_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "eligible",
          "capabilities",
          "tool_modal_support",
          "context_limit_tokens",
          "reasoning_controls",
          "cost_class",
          "latency_class",
          "provider_restrictions"
        ],
        "properties": {
          "model": { "type": "string", "minLength": 1 },
          "eligible": { "type": "string", "enum": ["eligible", "ineligible"] },
          "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "tool_modal_support": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "context_limit_tokens": { "type": "integer", "minimum": 1 },
          "reasoning_controls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "cost_class": { "type": "string", "minLength": 1 },
          "latency_class": { "type": "string", "minLength": 1 },
          "provider_restrictions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "protected_routing_policy_ref", "representative_evaluation_evidence"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "protected_routing_policy_ref": { "type": "string", "minLength": 1 },
        "representative_evaluation_evidence": { "type": "string", "minLength": 1 }
      }
    },
    "external_content_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanism_version", "eligibility", "source_kinds"],
      "properties": {
        "mechanism_version": { "type": "string", "const": "1" },
        "eligibility": { "type": "string", "enum": ["covered", "not_exercised"] },
        "source_kinds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["tracker", "pull_request", "web", "document", "tool_return"] } },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "evidence_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "allOf": [
        { "if": { "properties": { "eligibility": { "const": "covered" } } }, "then": { "required": ["evidence_ref", "evidence_sha256"], "properties": { "source_kinds": { "minItems": 1 } } } },
        { "if": { "properties": { "eligibility": { "const": "not_exercised" } } }, "then": { "properties": { "source_kinds": { "maxItems": 0 } }, "not": { "anyOf": [{ "required": ["evidence_ref"] }, { "required": ["evidence_sha256"] }] } } }
      ]
    },
    "unsupported_features": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "mutationClassEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition"],
      "properties": {
        "disposition": { "type": "string", "enum": ["covered", "not_covered", "not_applicable"] },
        "evidence_ref": { "type": "string", "minLength": 1 },
        "evidence_resolution": {
          "type": "string",
          "enum": ["in_repository", "outside_repository"],
          "description": "WI011-AC06: whether evidence_ref names a path this repository actually holds. in_repository is checked -- a declaration claiming it for a path the tree does not hold is rejected -- so the claim cannot be made freely. outside_repository states plainly that no control can resolve the reference, which is what all sixteen references in the two reference adapters were doing silently before this field existed. Whether adapter evidence is brought inside the repository stays an owner decision this field records rather than takes."
        },
        "justification": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "required": ["disposition"],
            "properties": { "disposition": { "const": "covered" } }
          },
          "then": { "required": ["evidence_ref", "evidence_resolution"] }
        },
        {
          "if": {
            "required": ["disposition"],
            "properties": { "disposition": { "const": "not_covered" } }
          },
          "then": { "required": ["evidence_ref", "evidence_resolution"] }
        },
        {
          "if": {
            "required": ["disposition"],
            "properties": { "disposition": { "const": "not_applicable" } }
          },
          "then": { "required": ["evidence_ref", "evidence_resolution", "justification"] }
        }
      ]
    },
    "capabilityStatus": {
      "type": "string",
      "enum": ["supported", "not_supported", "not_exercised"],
      "description": "WI011-AC05. supported and not_supported are verdicts; not_exercised says the capability was never exercised, which neither of the other two could express. Before this value existed a declaration had to pick a verdict it could not support, which is how codex.yaml came to declare worktree_support: not_supported while its own unsupported_features said a worktree exists and was never created in this project."
    },
    "freeformCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "description"],
      "properties": {
        "status": { "$ref": "#/$defs/capabilityStatus" },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
